{
    "LogLevel": "info",
    "LogMode": "console",
    "LogFilePath": "./acp.log",
    "CopyEngine": "AIO",
    "CopyParallelism": 4,
    "CopyDirMTime": false,
    "FullCopyBeforeInotify": false,
    "PreserveSparseFiles": true,
    "CopyOptions": {
        "QueueDepth": 16,
        "IOSize": 1048576,
        "Batch": 8,
        "IOReapWait": 1
    }
}