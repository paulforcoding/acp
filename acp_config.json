{
    "LogLevel": "info",
    "LogMode": "console",
    "LogFilePath": "./acp.log",
    "CopyEngine": "liburing",
    "CopyMode": "CksumCopy",
    "CopyParallelism": 1,
    "EnableInotify": false,
    "PreserveSparseFiles": true,
    "DirectIO": false,
    "SyncWrites": false,
    "CopyOptions": {
        "QueueDepth": 8,
        "IOSize": 1048576,
        "Batch": 8,
        "IOReapWait": 1
    }
}