{
  "ProgramLogLevel": "info",
  "ProgramLogMode": "console",
  "ProgramLogFilePath": "./acp.log",
  "FileLogEnabled": false,
  "FileLogIntervalSec": 5,
  "FileLogPath": "./.acp_state.json",
  "CopyEngine": "libaio",
  "CopyMode": "CopyOnly",
  "CksumAlgorithm": "xxhash64",
  "CopyParallelism": 1,
  "CopyChanSize": 10,
  "EnableInotify": false,
  "PreserveSparseFiles": true,
  "DirectIO": false,
  "SyncWrites": false,
  "CopyOptions": {
    "QueueDepth": 8,
    "IOSize": 1048576,
    "Batch": 8,
    "IOReapWait": 1
  }
}
