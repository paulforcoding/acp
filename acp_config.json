{
    "LogLevel": "debug",
    "LogMode": "console",
    "LogFilePath": "./acp.log",
    "CopyEngine": "libaio",
    "CopyParallelism": 4,
    "EnableInotify": true,
    "PreserveSparseFiles": true,
    "CopyOptions": {
        "QueueDepth": 16,
        "IOSize": 1048576,
        "Batch": 8,
        "IOReapWait": 1
    }
}