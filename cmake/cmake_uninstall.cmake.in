if(NOT EXISTS "@CMAKE_BINARY_DIR@/install_manifest.txt")
    message(FATAL_ERROR "Cannot find install manifest: @CMAKE_BINARY_DIR@/install_manifest.txt")
endif()

file(READ "@CMAKE_BINARY_DIR@/install_manifest.txt" files)
string(REGEX REPLACE "\n" ";" files "${files}")

set(dirs_to_cleanup "")
foreach(file ${files})
    if(IS_SYMLINK "${file}" OR EXISTS "${file}")
        message(STATUS "Removing: ${file}")
        execute_process(
            COMMAND @CMAKE_COMMAND@ -E remove "${file}"
            OUTPUT_VARIABLE rm_out
            RESULT_VARIABLE rm_retval
        )
        if(NOT "${rm_retval}" STREQUAL "0")
            message(FATAL_ERROR "Failed to remove ${file}")
        endif()
    else()
        message(STATUS "Does not exist: ${file}")
    endif()

    # Collect parent directories for cleanup
    get_filename_component(parent_dir "${file}" DIRECTORY)
    while(parent_dir AND NOT parent_dir STREQUAL "@CMAKE_INSTALL_PREFIX@" AND NOT parent_dir STREQUAL "/")
        list(APPEND dirs_to_cleanup "${parent_dir}")
        get_filename_component(parent_dir "${parent_dir}" DIRECTORY)
    endwhile()
endforeach()

# Remove empty directories from deepest to shallowest
if(dirs_to_cleanup)
    list(REMOVE_DUPLICATES dirs_to_cleanup)
    list(SORT dirs_to_cleanup)
    list(REVERSE dirs_to_cleanup)
    foreach(dir ${dirs_to_cleanup})
        if(IS_DIRECTORY "${dir}")
            file(GLOB dir_contents "${dir}/*")
            if(NOT dir_contents)
                message(STATUS "Removing empty directory: ${dir}")
                file(REMOVE_RECURSE "${dir}")
            endif()
        endif()
    endforeach()
endif()
