# Oracle Linux 9 build/debug/test environment for acp
FROM oraclelinux:9

# Enable EPEL and CodeReady Builder (CRB) for development packages
RUN dnf install -y oracle-epel-release-el9 \
    && dnf config-manager --set-enabled ol9_codeready_builder \
    && dnf config-manager --set-enabled ol9_developer_EPEL \
    && dnf clean all

# Install build dependencies
RUN dnf install -y \
    gcc gcc-c++ cmake ninja-build git gdb \
    libaio-devel \
    spdlog-devel \
    fmt-devel \
    openssl-devel \
    xxhash-devel \
    liburing-devel \
    pkgconfig \
    && dnf clean all

WORKDIR /acp

# Default: keep container running for interactive use
CMD ["/bin/bash"]
